# Supabase (Phase 3) — get these from your Supabase project's Settings > API.
# NEVER commit the real .env.local file or the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used exclusively in server actions / route handlers that need
# to bypass RLS for legitimate admin operations. Must never reach the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (password reset / notifications) — filled in when wired up
# RESEND_API_KEY=
